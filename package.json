{
  "name": "cheongyak-moa",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs web",
    "build:api": "node scripts/build.mjs api",
    "build:vercel": "npm run build && node apps/api/dist/cli/build-vercel.mjs",
    "presnapshot:preview": "npm run build:api",
    "snapshot:preview": "node --experimental-sqlite --env-file-if-exists=.env apps/api/dist/cli/snapshot-preview.mjs",
    "dev": "node scripts/dev.mjs",
    "prepreview": "npm run build",
    "preview": "node --experimental-sqlite apps/api/dist/cli/preview.mjs",
    "prepreview:vercel": "npm run build",
    "preview:vercel": "node --experimental-sqlite apps/api/dist/cli/preview-vercel.mjs",
    "prestart": "npm run build",
    "start": "node --experimental-sqlite --env-file-if-exists=.env apps/api/dist/server.mjs",
    "typecheck": "tsc -b && tsc -p apps/api && tsc -p apps/web",
    "test": "node scripts/test.mjs",
    "test:ui": "node scripts/test.mjs ui",
    "check": "npm run typecheck && npm run build && npm test && npm run test:ui",
    "lint": "node scripts/check-boundaries.mjs",
    "precollect": "npm run build:api",
    "precollect:all": "npm run build:api",
    "collect:all": "node --experimental-sqlite --env-file-if-exists=.env apps/api/dist/cli/collect.mjs --boards --all-dates",
    "precollect:retry": "npm run build:api",
    "collect:retry": "node --experimental-sqlite --env-file-if-exists=.env apps/api/dist/cli/collect.mjs --boards --retry-failed",
    "precoverage": "npm run build:api",
    "coverage": "node --experimental-sqlite apps/api/dist/cli/coverage.mjs",
    "precollect:local": "npm run build:api",
    "precollect:boards": "npm run build:api",
    "collect:boards": "node --experimental-sqlite --env-file-if-exists=.env apps/api/dist/cli/boards.mjs",
    "collect:local": "node --experimental-sqlite --env-file-if-exists=.env apps/api/dist/cli/local.mjs",
    "precollect:prices": "npm run build:api",
    "collect:prices": "node --experimental-sqlite --env-file-if-exists=.env apps/api/dist/cli/prices.mjs",
    "collect": "node --experimental-sqlite --env-file-if-exists=.env apps/api/dist/cli/collect.mjs",
    "predoctor": "npm run build:api",
    "doctor": "node --env-file-if-exists=.env apps/api/dist/cli/doctor.mjs",
    "presetup:env": "npm run build:api",
    "setup:env": "node apps/api/dist/cli/setup-env.mjs",
    "preimport:data": "npm run build:api",
    "import:data": "node --experimental-sqlite apps/api/dist/cli/import-response.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "format": "prettier --write apps packages scripts test *.json *.md .github .githooks",
    "format:check": "prettier --check apps packages scripts test *.json *.md .github .githooks",
    "commit:check": "node scripts/check-commit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
