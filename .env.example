# 공공데이터포털의 일반 인증키(Decoding)를 입력하세요. 인증키를 공개하지 마세요.
APPLYHOME_SERVICE_KEY=
LH_SERVICE_KEY=
# 마이홈 공공주택 모집공고 API(15108420) 활용 승인 필요. 비어 있으면 LH 키를 사용합니다.
MYHOME_SERVICE_KEY=
PORT=4310
# 수집 범위: 최근 180일 모집공고. 전체 기간을 수집했다는 의미가 아닙니다.
COLLECT_LOOKBACK_DAYS=180
# 파일 생성 후 키를 입력하고 서버를 재시작하세요. 키 값은 Git에 포함하지 않습니다.
